---
// resume.astro
// Interactive resume page with print optimization (Ctrl+P).
import Layout from '../layouts/Layout.astro';
import { SITE_METADATA, SKILLS, RESUME_GDRIVE_LINK } from '../constants';
---

<Layout title="Resume | Aalind Singh" description="Professional experience, skills, and academic qualifications. Optimized for both screen viewing and printing.">
  <section class="resume-section section">
    <div class="container resume-container">
      
      <!-- Print & Download Actions (Hide in print mode) -->
      <div class="resume-actions-banner glass-panel no-print">
        <div class="actions-text">
          <h2>Professional Resume</h2>
          <p>Download the official PDF version of my resume directly from Google Drive.</p>
        </div>
        <div class="actions-buttons">
          <a href={RESUME_GDRIVE_LINK} class="btn btn-primary" id="btn-resume-page-download" title="Download Resume PDF">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download Resume
          </a>
        </div>
      </div>

      <!-- Printable Resume Document (Styled for A4 page breaks) -->
      <div class="resume-document glass-panel">
        <!-- Header -->
        <header class="resume-doc-header">
          <div class="header-main">
            <h1 class="resume-name">{SITE_METADATA.author}</h1>
            <p class="resume-role text-gradient">Backend Engineer</p>
          </div>
          <div class="resume-contact-details">
            <p>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <a href={`mailto:${SITE_METADATA.email}`}>{SITE_METADATA.email}</a>
            </p>
            <p>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>{SITE_METADATA.phone}</span>
            </p>
            <p>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              <span>{SITE_METADATA.location}</span>
            </p>
            <p>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
              <a href={SITE_METADATA.linkedin} target="_blank">{SITE_METADATA.linkedin.replace('https://', '')}</a>
            </p>
            <p>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
              <a href={SITE_METADATA.github} target="_blank">{SITE_METADATA.github.replace('https://', '')}</a>
            </p>
          </div>
        </header>

        <!-- Document Grid -->
        <div class="resume-grid">
          
          <!-- Experience, Projects & Education (Left/Main Column) -->
          <div class="resume-main-column">
            <!-- Professional Experience -->
            <section class="resume-section-block">
              <h2 class="resume-block-title">Professional Experience</h2>
              
              <div class="timeline">
                <!-- Monotype Solutions -->
                <div class="timeline-item">
                  <div class="timeline-marker"></div>
                  <div class="timeline-content">
                    <div class="job-meta">
                      <h3 class="job-title">Monotype Solutions</h3>
                      <span class="job-duration">Noida, India</span>
                    </div>
                    <p class="job-company">FastApi, Django, DRF, PostgreSQL, AWS, Redis, Celery, RabbitMQ, Docker</p>
                    
                    <div class="role-group">
                      <div class="role-item">
                        <span class="role-name">Software Engineer 2</span>
                        <span class="role-date">January 2026 - Present</span>
                      </div>
                      <div class="role-item">
                        <span class="role-name">Software Engineer 1</span>
                        <span class="role-date">February 2024 - December 2025</span>
                      </div>
                      <div class="role-item">
                        <span class="role-name">Software Engineer Trainee</span>
                        <span class="role-date">August 2023 - January 2024</span>
                      </div>
                    </div>
                    
                    <div class="job-details">
                      <ul class="job-bullets">
                        <li>Owned and Designed a <strong>lead enrichment workflow</strong> combining web scraping, data extraction, and semantic analysis to generate high-quality prospect datasets that supported <strong>$50M+</strong> in annual revenue opportunities.</li>
                        <li>Owned and evolved a production-scale <strong>Node.js/Puppeteer</strong> web scraping platform processing <strong>200K+ websites/month</strong>, transitioning an externally developed system to internal ownership while improving maintainability, reliability, and operational practices.</li>
                        <li>Developed an <strong>ML-powered semantic font-matching</strong> system using transformer-based embeddings and approximate nearest neighbor search, automating a previously manual workflow and reducing processing time by <strong>85%</strong>.</li>
                        <li>Engineered a high-performance data consolidation pipeline to process millions of records across multiple tables in Excel using <strong>cursor-based pagination</strong>, raw SQL, and streaming iterators, reducing memory usage by <strong>80%</strong> and eliminating timeouts.</li>
                        <li>Designed and implemented <strong>Celery-based distributed asynchronous task pipelines</strong> in RabbitMQ to handle long-running jobs, introducing parallel execution and retry-safe mechanisms, reducing execution time by <strong>40%</strong> and eliminating timeout failures.</li>
                        <li>Engineered a fault-tolerant <strong>PDF processing pipeline</strong> using Django and Celery, introducing asynchronous stage-based workflows, idempotent task execution, and retry mechanisms to handle large files reliably without duplication or timeouts.</li>
                        <li>Optimized critical backend workflows using <strong>multithreading and multiprocessing</strong>, achieving an <strong>80% performance improvement</strong> in automation services and scripts.</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <!-- Projects Block -->
            <section class="resume-section-block">
              <h2 class="resume-block-title">Key Projects</h2>
              
              <div class="project-item">
                <div class="project-header">
                  <h3>AI Knowledge Assistant (RAG)</h3>
                  <span class="project-tech">FastAPI, Python, PostgreSQL, Redis, Celery, Qdrant, Docker</span>
                </div>
                <ul class="job-bullets project-bullets">
                  <li>Built a Retrieval-Augmented Generation (RAG) platform using FastAPI, implementing document ingestion, chunking, embeddings, and vector search to enable context-aware question answering.</li>
                  <li>Designed a scalable retrieval pipeline with Redis, Celery, and PostgreSQL, supporting asynchronous document indexing, metadata filtering, and low-latency semantic search.</li>
                </ul>
              </div>
            </section>

            <!-- Education Block -->
            <section class="resume-section-block">
              <h2 class="resume-block-title">Education</h2>
              
              <div class="education-item">
                <div class="job-meta">
                  <h3 class="job-title">KIET Group of Institutions</h3>
                  <span class="job-duration">2019 - 2023</span>
                </div>
                <p class="job-company">Bachelors of Technology - Electronics and Communications</p>
                <p class="academic-score">Score: <strong>8.0 CGPA</strong></p>
              </div>
            </section>

            <!-- Achievements Block -->
            <section class="resume-section-block">
              <h2 class="resume-block-title">Achievements and Honors</h2>
              <ul class="job-bullets achievements-bullets">
                <li><strong>199 Global rank</strong> in October Long Challenge on Codechef out of 17,000 contestants (username: <a href="https://www.codechef.com/users/novoid" target="_blank" rel="noopener noreferrer">novoid</a>).</li>
                <li><strong>First author</strong> of the research paper <em>"Image Captioning Using Python"</em> published in <strong>IEEE Xplore</strong>.</li>
              </ul>
            </section>
          </div>

          <!-- Skills Sidebar (Right Column) -->
          <aside class="resume-sidebar-column">
            <section class="resume-sidebar-block">
              <h2 class="resume-block-title">Technical Skills</h2>
              <div class="resume-skill-list">
                {SKILLS.languages.map((lang) => (
                  <span class="resume-skill-badge">{lang}</span>
                ))}
              </div>
            </section>

            <section class="resume-sidebar-block">
              <h2 class="resume-block-title">Libraries & Frameworks</h2>
              <div class="resume-skill-list">
                {SKILLS.libraries.map((lib) => (
                  <span class="resume-skill-badge">{lib}</span>
                ))}
              </div>
            </section>

            <section class="resume-sidebar-block">
              <h2 class="resume-block-title">Databases & Cloud</h2>
              <div class="resume-skill-list">
                {SKILLS.databases.map((db) => (
                  <span class="resume-skill-badge">{db}</span>
                ))}
              </div>
            </section>

            <section class="resume-sidebar-block">
              <h2 class="resume-block-title">Tools & OS</h2>
              <div class="resume-skill-list">
                {SKILLS.tools.map((t) => (
                  <span class="resume-skill-badge">{t}</span>
                ))}
              </div>
            </section>

            <!-- Interactive details helper (no print) -->
            <section class="resume-sidebar-block interactive-details-card no-print">
              <h3>Timeline Control</h3>
              <p>Click details below to toggle item lists on screen.</p>
              <button class="btn btn-secondary btn-sm" id="btn-toggle-bullets" style="width: 100%; margin-top: 0.75rem;">
                Collapse Details
              </button>
            </section>
          </aside>
          
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .resume-section {
    padding-top: 3rem;
  }

  .resume-container {
    max-width: 1000px;
  }

  /* Actions Header styling */
  .resume-actions-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem;
    margin-bottom: 2.5rem;
    border-color: var(--border-color);
  }

  .actions-text h2 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .actions-text p {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .actions-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Resume Document Styling */
  .resume-document {
    padding: 4rem;
    border-color: var(--border-color);
    background: var(--card-bg);
  }

  .resume-doc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 2.5rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .resume-name {
    font-size: 2.75rem;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
  }

  .resume-role {
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .resume-contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .resume-contact-details p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .resume-contact-details a {
    color: inherit;
  }

  .resume-contact-details a:hover {
    color: var(--theme-accent);
  }

  /* Grid details */
  .resume-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
  }

  .resume-block-title {
    font-size: 1.25rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Experience Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    position: relative;
    border-left: 2px solid var(--border-color);
    padding-left: 2rem;
    padding-bottom: 2rem;
  }

  .timeline-item:last-child {
    border-left: 2px solid transparent;
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: -7px;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--theme-accent);
    border: 2px solid var(--bg-primary);
    transition: background-color var(--transition-normal);
  }

  .job-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .job-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .job-duration {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-tertiary);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border-color);
  }

  .job-company {
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
  }

  .role-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
    padding: 0.75rem 1rem;
    background: var(--bg-secondary);
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--border-color);
  }

  .role-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .role-name {
    color: var(--text-primary);
    font-weight: 600;
  }

  .role-date {
    color: var(--theme-accent);
  }

  .job-bullets {
    list-style-type: square;
    padding-left: 1.25rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .job-bullets li {
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  /* Projects in resume */
  .project-item {
    margin-bottom: 2rem;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-header h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .project-tech {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--theme-accent);
  }

  .project-bullets {
    padding-left: 1.25rem;
  }

  /* Education block */
  .education-item {
    margin-bottom: 1.5rem;
  }
  
  .academic-score {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  /* Sidebar blocks details */
  .resume-sidebar-block {
    margin-bottom: 2.5rem;
  }

  .resume-skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .resume-skill-badge {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 0.35rem 0.6rem;
    border-radius: var(--border-radius-sm);
    font-size: 0.85rem;
    font-weight: 500;
    font-family: var(--font-mono);
  }

  .interactive-details-card h3 {
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .interactive-details-card p {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Responsive layout setups */
  @media (max-width: 900px) {
    .resume-actions-banner {
      flex-direction: column;
      gap: 1.5rem;
      text-align: center;
    }

    .resume-document {
      padding: 2rem;
    }

    .resume-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>

<!-- Script for Interactive Timeline Toggles and Print Triggers -->
<script>
  document.addEventListener('DOMContentLoaded', () => {


    // 2. Interactive Bullet points collapser
    const toggleBulletsBtn = document.getElementById('btn-toggle-bullets');
    const jobDetailsContainers = document.querySelectorAll('.job-details, .project-bullets');
    let isCollapsed = false;

    if (toggleBulletsBtn) {
      toggleBulletsBtn.addEventListener('click', () => {
        isCollapsed = !isCollapsed;
        
        jobDetailsContainers.forEach((containerNode) => {
          const container = containerNode as HTMLElement;
          if (isCollapsed) {
            container.style.display = 'none';
          } else {
            container.style.display = 'block';
          }
        });

        toggleBulletsBtn.textContent = isCollapsed ? 'Expand Details' : 'Collapse Details';
      });
    }
  });
</script>
